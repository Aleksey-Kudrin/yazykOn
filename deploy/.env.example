# Public IP/DNS-reachable address used in ICE host candidates.
WEBRTC_PUBLIC_IP=

# Public address advertised by coturn. Required when the server is behind NAT.
TURN_PUBLIC_IP=
TURN_REALM=turn.yazykon.example
TURN_USERNAME=yazykon
TURN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Browser ICE configuration. STUN defaults to Google's public STUN.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=turn:turn.yazykon.example:3478
